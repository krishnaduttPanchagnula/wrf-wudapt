! Corrected WPS configuration for Milan.
! Changes vs thesis: proper Lambert parallels (30N/60N, not "3.5 lat / 7 lon"),
! 24 h spin-up, MODIS 20-category land use, and explicit urban-parameter source.
! Validate against the WRF Users Guide for the exact WRF version built.
&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2022-07-25_00:00:00', '2022-07-25_00:00:00',
 end_date   = '2022-07-25_18:00:00', '2022-07-25_18:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
 debug_level = 0
/

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1,  31,
 j_parent_start    =   1,  31,
 e_we              =  91,  91,
 e_sn              =  91,  91,
 geog_data_res     = 'lowres', 'lowres',
 dx = 9000,
 dy = 9000,
 map_proj = 'lambert',
 ref_lat   = 45.4937,
 ref_lon   =  9.16646,
 truelat1  = 30.0,
 truelat2  = 60.0,
 stand_lon =  9.16646,
 geog_data_path = 'PATH_TO_WPS_GEOG'
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE'
/

&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2
/
