! Corrected WRF configuration for Milan, 2020 heat event.
! Fixes vs thesis Table 6:
!   ra_sw_physics = 4 (RRTMG SW). Thesis labelled this "QNSE-EDMF (4)" -- QNSE-EDMF is a PBL scheme.
!   sf_surface_physics = 2 (Noah), single LSM. Thesis listed both Noah-MP(4) and "Unified Noah".
!   bl_pbl_physics = 1 (YSU) with sf_sfclay_physics = 1 (MM5), consistent with BEP.
!   Urban extent comes from the WUDAPT LCZ map via w2w (LCZ_extent geo_em);
!   land use stays MODIS 21-category so BEP can run without a WRF source rebuild.
!   shortcut: per-LCZ urban canopy parameters are not ingested; upgrade by enabling
!   use_wudapt_lcz=1 with a WRF build that supports 41 LCZ categories.
!   cumulus off on the 3 km inner domain (grey zone); on for the 9 km parent only.
!   time_step = 18 s for the 3 km finest grid (~6 s per km).
! num_metgrid_levels MUST be set from the actual metgrid file before each run.
&time_control
 run_days = 0,
 run_hours = 0,
 run_minutes = 0,
 run_seconds = 0,
 start_year = 2022, 2022,
 start_month = 7, 7,
 start_day = 25, 25,
 start_hour = 0, 0,
 end_year = 2022, 2022,
 end_month = 7, 7,
 end_day = 25, 25,
 end_hour = 18, 18,
 interval_seconds = 21600,
 input_from_file = .true., .true.,
 history_interval = 60, 60,
 frames_per_outfile = 24, 24,
 restart = .false.,
 restart_interval = 720,
 io_form_history = 2,
 use_netcdf_classic = .true.,
 io_form_restart = 2,
 io_form_input = 2,
 io_form_boundary = 2,
 debug_level = 0
/

&domains
 time_step = 18,
 time_step_fract_num = 0,
 time_step_fract_den = 1,
 max_dom = 2,
 e_we = 91, 91,
 e_sn = 91, 91,
 e_vert = 45, 45,
 p_top_requested = 5000,
 num_metgrid_levels = 34,
 num_metgrid_soil_levels = 4,
 dx = 9000, 3000,
 dy = 9000, 3000,
 grid_id = 1, 2,
 parent_id = 1, 1,
 i_parent_start = 1, 31,
 j_parent_start = 1, 31,
 parent_grid_ratio = 1, 3,
 parent_time_step_ratio = 1, 3,
 feedback = 1,
 smooth_option = 0
/

&physics
 mp_physics = 6, 6,
 ra_lw_physics = 4, 4,
 ra_sw_physics = 4, 4,
 radt = 18, 9,
 sf_sfclay_physics = 1, 1,
 sf_surface_physics = 2, 2,
 bl_pbl_physics = 1, 1,
 topo_wind = 0, 0,
 bldt = 0, 0,
 cu_physics = 1, 0,
 cudt = 0, 0,
 surface_input_source = 1,
 num_soil_layers = 4,
 num_land_cat = 21,
 sf_urban_physics = 2, 2
/

&dynamics
 w_damping = 1,
 diff_opt = 2,
 km_opt = 4,
 diff_6th_opt = 2,
 diff_6th_factor = 0.12,
 base_temp = 290,
 damp_opt = 3,
 epssm = 0.1, 0.2,
 non_hydrostatic = .true., .true.,
 moist_adv_opt = 1, 1,
 scalar_adv_opt = 1, 1
/

&bdy_control
 spec_bdy_width = 5,
 spec_zone = 1,
 relax_zone = 4,
 specified = .true., .false.,
 nested = .false., .true.
/

&grib2
/

&namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1
/
